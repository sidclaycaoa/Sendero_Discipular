{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sendero-discipular",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": ["nodejs_compat"],
  // The D1 primary lives in Eastern North America (ENAM). Running the Worker next
  // to it turns each query into a local hop; the user pays one long trip per page.
  "placement": { "region": "gcp:us-east1" },
  "assets": { "binding": "ASSETS", "not_found_handling": "none", "run_worker_first": true },
  "images": { "binding": "IMAGES" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sendero-discipular",
      "database_id": "8eecf873-d8f3-44ff-b72c-74d9d573dcd1",
      "migrations_dir": "./drizzle"
    }
  ]
}
